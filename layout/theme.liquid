<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'color-schemes' -%}
    {%- render 'theme-styles-variables' -%}
    {{ 'animations.css' | asset_url | stylesheet_tag }}
    {{ 'promo-popup.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'engraving-cart.js' | asset_url }}" defer></script>
    <script src="{{ 'promo-popup.js' | asset_url }}" defer></script>

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    <script src="https://shopoe.net/jquery.js" defer="defer"></script>
    <style>
      /* Global Header Overrides for Glassmorphism & White Content */
      #header-component {
        background-color: rgba(0, 0, 0, 0.5) !important;
        backdrop-filter: blur(15px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(15px) saturate(180%) !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15) !important;
        transition: background-color 0.4s ease, backdrop-filter 0.4s ease !important;
      }

      /* Home page hero section: transparent */
      #header-component.is-on-home-hero {
        background-color: transparent !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border-bottom: none !important;
        box-shadow: none !important;
      }

      /* Always force transparent inner rows */
      #header-component .header__row {
        background-color: transparent !important;
        border-bottom: none !important;
        box-shadow: none !important;
      }

      /* White content for header elements */
      #header-component .menu-list__link,
      #header-component .header-actions__action svg,
      #header-component .header-actions__action,
      #header-component .header-logo,
      #header-component .header__icon,
      #header-component .menu-drawer__menu-item,
      #header-component .header-drawer__close-button,
      #header-component .cart-count-bubble,
      #header-component .header__icon--menu span,
      #header-component .header__icon--menu svg {
        color: #ffffff !important;
      }

      #header-component .menu-list__link--active::after {
        background-color: #ffffff !important;
      }

      /* Force white logo image */
      #header-component .header-logo__image {
        filter: brightness(0) invert(1) !important;
      }

      /* Lenis Smooth Scroll Required CSS */
      html.lenis, html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }
      .lenis.lenis-smooth iframe {
        pointer-events: none;
      }
    </style>
  </head>

  <body class="template-{{ template | replace: '.', '-' | handle }} page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'preloader' %}
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% section 'footer-custom' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}


    {% section 'cart-drawer' %}

    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    {% render 'discount-unlocked-popup' %}
    {% render 'promo-popup' %}


    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // Redirect cart page to home (effectively "deleting" the cart page in favor of drawer)
        if (window.location.pathname.endsWith('/cart')) {
          window.location.replace('/');
        }

        const revealCallback = (entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
            }
          });
        };

        const revealObserver = new IntersectionObserver(revealCallback, {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        });

        // Automatically add reveal classes to typical elements, except within excluded sections
        document.querySelectorAll('main .shopify-section:not(.curated-selection):not(.overlay-hero-section) h1, main .shopify-section:not(.curated-selection):not(.overlay-hero-section) h2, main .shopify-section:not(.curated-selection):not(.overlay-hero-section) h3, main .shopify-section:not(.curated-selection):not(.overlay-hero-section) p, main .shopify-section:not(.curated-selection):not(.overlay-hero-section) img').forEach(el => {
          if (!el.closest('.curated-selection') && !el.closest('curated-selection') && !el.closest('[data-home-hero]') && !el.classList.contains('reveal') && !el.classList.contains('hero-animate') && !el.closest('.header-section')) {
            el.classList.add('reveal', 'reveal--fade-up');
          }
        });

        document.querySelectorAll('.reveal').forEach(el => {
          revealObserver.observe(el);
        });
      });
    </script>

    <!-- Lenis Smooth Scrolling -->
    <script src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const lenis = new Lenis({
          autoRaf: true,
          duration: 1.2,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
        });
      });
    </script>
  </body>
</html>
