{%- if product.description != blank -%}
<div class="product-description-redesign" id="desc-redesign-{{ product.id }}">
  <!-- Desktop version: plain style, hidden on mobile -->
  <div class="product-description-redesign__desktop-content product-description-redesign__content rte">
    {{ product.description }}
  </div>

  <!-- Mobile version: accordion container, hidden on desktop -->
  <div class="product-description-redesign__mobile-accordion hidden">
    <!-- Accordion items will be injected here by JS -->
  </div>
</div>
{%- endif -%}

<style>
  @font-face {
    font-family: 'Galderglynn Titling';
    src: url('{{ "galderglynn-titling.extra-light.otf" | asset_url }}') format('opentype');
    font-weight: 200;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Galderglynn Titling';
    src: url('{{ "galderglynn-titling.light.otf" | asset_url }}') format('opentype');
    font-weight: 300;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Galderglynn Titling';
    src: url('{{ "galderglynn-titling.regular.otf" | asset_url }}') format('opentype'),
         url('{{ "Galderglynn Titling Rg.otf" | asset_url }}') format('opentype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: 'Galderglynn Titling';
    src: url('{{ "galderglynn-titling-bd.ttf" | asset_url }}') format('truetype'),
         url('{{ "Galderglynn Titling Bd.otf" | asset_url }}') format('opentype');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  .product-description-redesign {
    display: block !important;
    width: 100% !important;
    margin-bottom: 2rem;
  }
  
  .product-description-redesign__content {
    font-family: 'Galderglynn Titling', var(--font-body--family), sans-serif !important;
    font-size: 0.78rem;
    line-height: 1.5;
    letter-spacing: 0 !important;
    width: 100% !important;
    text-transform: uppercase !important;
  }

  .product-description-redesign__content p {
    font-family: 'Galderglynn Titling', var(--font-body--family), sans-serif !important;
    margin: 0 0 0.8rem 0 !important;
    font-weight: 200 !important;
    color: #555 !important;
    text-transform: uppercase !important;
    font-size: 0.78rem !important;
    line-height: 1.5 !important;
    letter-spacing: 2px !important;
  }

  /* Target paragraphs that wrap headings to eliminate the bottom margin space */
  .product-description-redesign__content p:has(strong),
  .product-description-redesign__content p:has(b),
  .product-description-redesign__content p:has(h1),
  .product-description-redesign__content p:has(h2),
  .product-description-redesign__content p:has(h3),
  .product-description-redesign__content p:has(h4),
  .product-description-redesign__content p:has(h5),
  .product-description-redesign__content p:has(h6) {
    margin-bottom: 0.25rem !important;
  }

  .product-description-redesign__content strong,
  .product-description-redesign__content b,
  .product-description-redesign__content h1,
  .product-description-redesign__content h2,
  .product-description-redesign__content h3,
  .product-description-redesign__content h4,
  .product-description-redesign__content h5,
  .product-description-redesign__content h6 {
    font-family: 'Galderglynn Titling', var(--font-body--family), sans-serif !important;
    display: block !important;
    font-weight: 300 !important;
    color: #000 !important;
    margin-top: 0.8rem !important;
    margin-bottom: 0.25rem !important;
    text-transform: uppercase !important;
    font-size: 0.85rem !important;
    letter-spacing: 0 !important;
  }

  /* First element resets */
  .product-description-redesign__content > strong:first-child,
  .product-description-redesign__content > b:first-child,
  .product-description-redesign__content > p:first-child strong,
  .product-description-redesign__content > p:first-child b,
  .product-description-redesign__content > p:first-child,
  .product-description-redesign__content > h1:first-child,
  .product-description-redesign__content > h2:first-child,
  .product-description-redesign__content > h3:first-child,
  .product-description-redesign__content > h4:first-child,
  .product-description-redesign__content > h5:first-child,
  .product-description-redesign__content > h6:first-child,
  .product-description-redesign__content > p:first-child h1,
  .product-description-redesign__content > p:first-child h2,
  .product-description-redesign__content > p:first-child h3,
  .product-description-redesign__content > p:first-child h4,
  .product-description-redesign__content > p:first-child h5,
  .product-description-redesign__content > p:first-child h6 {
    margin-top: 0 !important;
  }

  /* If a paragraph contains a strong/b as its first child, ensure it displays block */
  .product-description-redesign__content p strong,
  .product-description-redesign__content p b,
  .product-description-redesign__content p h1,
  .product-description-redesign__content p h2,
  .product-description-redesign__content p h3,
  .product-description-redesign__content p h4,
  .product-description-redesign__content p h5,
  .product-description-redesign__content p h6 {
    display: block !important;
  }

  /* Accordion mobile styles */
  .description-accordion {
    width: 100%;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    margin-top: 1rem;
    margin-bottom: 2rem;
  }
  
  .description-accordion-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  
  .description-accordion-trigger {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.25rem 0;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-family: 'Galderglynn Titling', var(--font-body--family), sans-serif;
    font-size: 0.82rem;
    font-weight: 300;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #000;
    transition: opacity 0.25s ease;
    -webkit-tap-highlight-color: transparent;
  }
  
  .description-accordion-trigger:hover {
    opacity: 0.8;
  }
  
  .description-accordion-icon {
    display: flex;
    align-items: center;
    transition: transform 0.25s ease-in-out;
    color: #555;
  }
  
  .description-accordion-trigger[aria-expanded="true"] .description-accordion-icon {
    transform: rotate(180deg);
  }
  
  .description-accordion-content-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease-in-out;
    overflow: hidden;
  }
  
  .description-accordion-content {
    min-height: 0;
  }
  
  .description-accordion-text {
    padding-top: 0.25rem;
    padding-bottom: 1.5rem;
    font-family: 'Galderglynn Titling', var(--font-body--family), sans-serif;
    font-size: 0.88rem;
    line-height: 1.6;
    letter-spacing: 2px;
    font-weight: 200;
    color: #555;
    text-transform: lowercase;
  }
  
  .description-accordion-text p {
    margin: 0 0 0.4rem 0;
    padding: 0;
  }
  
  .description-accordion-text p:last-child {
    margin-bottom: 0;
  }

  .description-accordion-text p::first-letter {
    text-transform: uppercase;
  }

  /* Responsive styling */
  @media screen and (min-width: 1025px) {
    .product-description-redesign__mobile-accordion {
      display: none !important;
    }
    .product-description-redesign__desktop-content {
      display: block !important;
    }
    .product-description-redesign__content {
      font-size: 0.8rem !important;
    }
    .product-description-redesign__content p {
      font-size: 0.8rem !important;
    }
    .product-description-redesign__content strong,
    .product-description-redesign__content b {
      font-size: 0.88rem !important;
    }
  }

  @media screen and (max-width: 1024px) {
    .product-description-redesign__desktop-content {
      display: none !important;
    }
    .product-description-redesign__mobile-accordion {
      display: block !important;
    }
  }
</style>

<script>
  (function() {
    function initAccordion() {
      const containerId = 'desc-redesign-{{ product.id }}';
      const container = document.getElementById(containerId);
      if (!container) return;
      if (container.dataset.accordionInitialized === 'true') return;
      container.dataset.accordionInitialized = 'true';

      const desktopContent = container.querySelector('.product-description-redesign__desktop-content');
      const mobileAccordionContainer = container.querySelector('.product-description-redesign__mobile-accordion');
      if (!desktopContent || !mobileAccordionContainer) return;

      const rawText = desktopContent.innerText || desktopContent.textContent || '';
      
      const parsed = (function(descText) {
        if (!descText) return { description: "", notes: "", feelsLike: "" };
        const normalized = descText.replace(/\r\n/g, "\n");
        
        const notesMatch = normalized.match(/(?:^|\n)\s*(NOTES)\s*(?:\n|$)/i);
        const feelsLikeMatch = normalized.match(/(?:^|\n)\s*(FEELS\s+LIKE)\s*(?:\n|$)/i);
        
        let description = normalized;
        let notes = "";
        let feelsLike = "";
        
        const notesIndex = (notesMatch && typeof notesMatch.index === 'number') ? notesMatch.index : -1;
        const feelsLikeIndex = (feelsLikeMatch && typeof feelsLikeMatch.index === 'number') ? feelsLikeMatch.index : -1;
        
        if (notesIndex !== -1 && feelsLikeIndex !== -1 && notesMatch && feelsLikeMatch) {
          if (notesIndex < feelsLikeIndex) {
            description = normalized.slice(0, notesIndex);
            notes = normalized.slice(notesIndex + notesMatch[0].length, feelsLikeIndex);
            feelsLike = normalized.slice(feelsLikeIndex + feelsLikeMatch[0].length);
          } else {
            description = normalized.slice(0, feelsLikeIndex);
            feelsLike = normalized.slice(feelsLikeIndex + feelsLikeMatch[0].length, notesIndex);
            notes = normalized.slice(notesIndex + notesMatch[0].length);
          }
        } else if (notesIndex !== -1 && notesMatch) {
          description = normalized.slice(0, notesIndex);
          notes = normalized.slice(notesIndex + notesMatch[0].length);
        } else if (feelsLikeIndex !== -1 && feelsLikeMatch) {
          description = normalized.slice(0, feelsLikeIndex);
          feelsLike = normalized.slice(feelsLikeIndex + feelsLikeMatch[0].length);
        }
        
        return {
          description: description.trim(),
          notes: notes.trim(),
          feelsLike: feelsLike.trim()
        };
      })(rawText);

      const sections = [
        { id: 'description', title: 'Description', content: parsed.description, isOpen: false },
        { id: 'notes', title: 'Notes', content: parsed.notes, isOpen: false },
        { id: 'feelsLike', title: 'Feels Like', content: parsed.feelsLike, isOpen: false }
      ].filter(s => s.content);

      if (sections.length === 0) return;

      let accordionHtml = '<div class="description-accordion">';
      sections.forEach(function(section) {
        const isExpanded = section.isOpen;
        accordionHtml += `
          <div class="description-accordion-item" data-section="${section.id}">
            <button class="description-accordion-trigger" aria-expanded="${isExpanded ? 'true' : 'false'}">
              <span class="description-accordion-title">${section.title}</span>
              <span class="description-accordion-icon">
                <svg class="chevron-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="description-accordion-content-wrapper" style="${isExpanded ? 'grid-template-rows: 1fr;' : 'grid-template-rows: 0fr;'}">
              <div class="description-accordion-content">
                <div class="description-accordion-text">
                  ${section.content.split('\n').map(line => line.trim()).filter(line => line.length > 0).map(line => `<p>${line}</p>`).join('')}
                </div>
              </div>
            </div>
          </div>
        `;
      });
      accordionHtml += '</div>';

      mobileAccordionContainer.innerHTML = accordionHtml;
      mobileAccordionContainer.classList.remove('hidden');

      const triggers = mobileAccordionContainer.querySelectorAll('.description-accordion-trigger');
      triggers.forEach(function(trigger) {
        trigger.addEventListener('click', function() {
          const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
          const wrapper = trigger.nextElementSibling;
          
          if (isExpanded) {
            trigger.setAttribute('aria-expanded', 'false');
            if (wrapper) wrapper.style.gridTemplateRows = '0fr';
          } else {
            triggers.forEach(function(otherTrigger) {
              if (otherTrigger !== trigger) {
                otherTrigger.setAttribute('aria-expanded', 'false');
                const otherWrapper = otherTrigger.nextElementSibling;
                if (otherWrapper) otherWrapper.style.gridTemplateRows = '0fr';
              }
            });

            trigger.setAttribute('aria-expanded', 'true');
            if (wrapper) wrapper.style.gridTemplateRows = '1fr';
          }
        });
      });
    }

    if (document.readyState !== 'loading') {
      initAccordion();
    } else {
      document.addEventListener('DOMContentLoaded', initAccordion);
    }

    document.addEventListener('shopify:section:load', function() {
      initAccordion();
    });
  })();
</script>
