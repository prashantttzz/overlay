
{% stylesheet %}
  .engraving-option {
    margin-bottom: 2rem;
    padding: 1.5rem;
    border: 1px solid rgba(0, 0, 0, 0.08);
    background: #fafafa;
    transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  }

  @media screen and (min-width: 750px) {
    .engraving-option {
      margin-bottom: 1rem;
      padding: 0.75rem;
      margin-top: 1rem;
      width: 50%;
    }
  }

  .engraving-option.is-active {
    background: #fff;
    border-color: #000;
  }

  .engraving-option__header {
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    user-select: none;
  }

  .engraving-option__checkbox {
    width: 20px;
    height: 20px;
    border: 1px solid #000;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.3s ease;
  }

  .engraving-option__checkbox::after {
    content: '';
    width: 10px;
    height: 10px;
    background: #000;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  input[type="checkbox"]:checked + .engraving-option__checkbox::after {
    opacity: 1;
  }

  .engraving-option__label {
    font-family: var(--font-galderglynn);
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .engraving-option__price {
    font-size: 14px;
    font-weight: 300;
    opacity: 0.6;
    margin-left: auto;
  }

  .engraving-option__content {
    max-height: 0;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    opacity: 0;
  }

  .engraving-option.is-active .engraving-option__content {
    max-height: 220px;
    opacity: 1;
    margin-top: 1.5rem;
  }

  .engraving-option__input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .engraving-option__input-group label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .engraving-option__input {
    width: 100%;
    padding: 14px 12px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    font-family: var(--font-galderglynn);
    font-size: 16px;
    background: transparent;
    outline: none;
    transition: border-color 0.3s ease;
    color: #000; /* Ensured black text as requested */
  }

  .engraving-option__input:focus {
    border-color: #000;
  }

  .engraving-option__countdown {
    font-weight: 400;
    opacity: 0.8;
    font-variant-numeric: tabular-nums;
  }

  .engraving-option__error {
    color: #c00;
    font-size: 11px;
    margin-top: 6px;
    font-style: italic;
    display: none;
  }

  .engraving-option__hint {
    font-size: 11px;
    margin-top: 10px;
    opacity: 0.4;
    font-style: italic;
  }

  .engraving-option__input-wrapper {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }

  .engraving-option__confirm {
    background: #000;
    color: #fff;
    border: 1px solid #000;
    padding: 0 18px;
    font-family: var(--font-galderglynn);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .engraving-option__confirm:hover {
    background: #333;
    border-color: #333;
  }

  .engraving-option__confirm.is-confirmed {
    background: #fff;
    color: #000;
    border-color: #000;
    cursor: default;
  }

  .engraving-option__confirm.is-confirmed::after {
    content: ' ✓';
    margin-left: 4px;
  }

  .engraving-font-selector {
    display: flex;
    gap: 8px;
    margin-top: 15px;
  }

  .engraving-font-option {
    flex: 1;
  }

  .engraving-font-option input {
    display: none;
  }

  .engraving-font-option label {
    display: block;
    padding: 10px 6px;
    border: 1px solid rgba(0, 0, 0, 0.1);
    text-align: center;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
    background: #fff;
    color: #000;
  }

  .engraving-font-option input:checked + label {
    border-color: #000;
    background: #000;
    color: #fff;
  }

  /* Font Preview Styles */
  .preview-font-normal { font-family: 'Roboto Mono', monospace !important; font-style: normal !important; }
  .preview-font-italic { font-family: 'Kapakana', cursive !important; font-style: italic !important; }
  .preview-font-arabic { font-family: 'The Year of Handicraft Regular', sans-serif !important; font-style: normal !important; font-size: 1.4em !important; text-transform: none !important; letter-spacing: 0 !important; }
{% endstylesheet %}

{%- unless product.tags contains 'no-engraving' -%}
<div class="engraving-option" id="engraving-{{ block.id }}"
     data-engraving-block
     data-engraving-variant-id="48572858400991"
     data-engraving-price="25.00">
  <label class="engraving-option__header">
    <input type="checkbox" id="engraving-toggle-{{ block.id }}" class="visually-hidden" data-engraving-toggle>
    <span class="engraving-option__checkbox"></span>
    <span class="engraving-option__label">Add Engraving</span>
    <span class="engraving-option__price">+ 25.00 AED</span>
  </label>

  <div class="engraving-option__content">
    <div class="engraving-option__input-group">
      <label for="engraving-text-{{ block.id }}">
        Personalized Message
        <span class="engraving-option__countdown" data-engraving-countdown>20 / 20</span>
      </label>
      <div class="engraving-option__input-wrapper">
        <input
          type="text"
          id="engraving-text-{{ block.id }}"
          class="engraving-option__input preview-font-normal"
          placeholder="Enter your text"
          maxlength="20"
          data-engraving-input
        >
        <button type="button" class="engraving-option__confirm" data-engraving-confirm>
          CONFIRM
        </button>
      </div>
      <p class="engraving-option__error" data-engraving-error>Please enter and confirm engraving text</p>
      
      <div class="engraving-font-selector">
        <div class="engraving-font-option">
          <input type="radio" name="engraving-font-{{ block.id }}" id="font-normal-{{ block.id }}" value="Normal" checked data-engraving-font>
          <label for="font-normal-{{ block.id }}">Normal</label>
        </div>
        <div class="engraving-font-option">
          <input type="radio" name="engraving-font-{{ block.id }}" id="font-italic-{{ block.id }}" value="Italic" data-engraving-font>
          <label for="font-italic-{{ block.id }}">Italic</label>
        </div>
        <div class="engraving-font-option">
          <input type="radio" name="engraving-font-{{ block.id }}" id="font-arabic-{{ block.id }}" value="Arabic" data-engraving-font>
          <label for="font-arabic-{{ block.id }}">Arabic</label>
        </div>
      </div>
    </div>
    <p class="engraving-option__hint">Engraving is permanent and adds 2-3 business days to processing.</p>
  </div>
</div>
{%- endunless -%}

{%- unless product.tags contains 'no-engraving' -%}
<script>
  (function() {
    const block = document.getElementById('engraving-{{ block.id }}');
    const toggle = block.querySelector('[data-engraving-toggle]');
    const input = block.querySelector('[data-engraving-input]');
    const countdown = block.querySelector('[data-engraving-countdown]');
    const errorEl = block.querySelector('[data-engraving-error]');
    const confirmBtn = block.querySelector('[data-engraving-confirm]');
    const fontOptions = block.querySelectorAll('[data-engraving-font]');
    let isConfirmed = false;

    const MAX_CHARS = 20;
    const PREVIEW_CONFIG = {
      normal: {
        maxFontMobile: 34,
        minFontMobile: 20,
        maxFontDesktop: 56,
        minFontDesktop: 26,
        shrinkStart: 3,
        shrinkEnd: 16,
        lineBreakStartMobile: 10,
        lineBreakStartDesktop: 14,
        lineCharsMobile: 8,
        lineCharsDesktop: 18,
      },
      italic: {
        maxFontMobile: 38,
        minFontMobile: 22,
        maxFontDesktop: 60,
        minFontDesktop: 28,
        shrinkStart: 3,
        shrinkEnd: 16,
        lineBreakStartMobile: 10,
        lineBreakStartDesktop: 14,
        lineCharsMobile: 8,
        lineCharsDesktop: 18,
      },
      arabic: {
        maxFontMobile: 28,
        minFontMobile: 14,
        maxFontDesktop: 48,
        minFontDesktop: 26,
        shrinkStart: 3,
        shrinkEnd: 16,
        lineBreakStartMobile: 8,
        lineBreakStartDesktop: 12,
        lineCharsMobile: 7,
        lineCharsDesktop: 16,
      }
    };

    // Find the global overlay in the media gallery (visual preview)
    const getGlobalOverlay = () => document.getElementById('engraving-overlay-global');
    const getSelectedFont = () => block.querySelector('[data-engraving-font]:checked')?.value.toLowerCase() || 'normal';

    function getPreviewConfig(selectedFont) {
      return PREVIEW_CONFIG[selectedFont] || PREVIEW_CONFIG.normal;
    }

    function getPreviewFontSize(textLength, selectedFont) {
      const config = getPreviewConfig(selectedFont);
      const isDesktop = window.innerWidth >= 750;
      const maxFont = isDesktop ? config.maxFontDesktop : config.maxFontMobile;
      const minFont = isDesktop ? config.minFontDesktop : config.minFontMobile;

      if (textLength <= config.shrinkStart) return maxFont;
      if (textLength >= config.shrinkEnd) return minFont;

      const progress = (textLength - config.shrinkStart) / (config.shrinkEnd - config.shrinkStart);
      return maxFont - ((maxFont - minFont) * progress);
    }

    function formatPreviewText(text, selectedFont) {
      const normalized = text.replace(/\s+/g, ' ').trim();
      const config = getPreviewConfig(selectedFont);
      const isDesktop = window.innerWidth >= 750;
      const lineChars = isDesktop ? config.lineCharsDesktop : config.lineCharsMobile;

      const lineBreakStart = isDesktop ? config.lineBreakStartDesktop : config.lineBreakStartMobile;

      if (normalized.length <= lineBreakStart || !normalized.includes(' ')) {
        if (normalized.length > lineBreakStart && !normalized.includes(' ')) {
          /* No spaces — force break the single long word */
          const lines = [];
          for (let i = 0; i < normalized.length; i += lineChars) {
            lines.push(normalized.substring(i, i + lineChars));
          }
          return lines.join('\n');
        }
        return normalized;
      }

      const words = normalized.split(' ');
      const lines = [];
      let currentLine = '';

      words.forEach((word) => {
        const nextLine = currentLine ? currentLine + ' ' + word : word;

        if (!currentLine || nextLine.length <= lineChars) {
          currentLine = nextLine;
          return;
        }

        lines.push(currentLine);
        currentLine = word;
      });

      if (currentLine) {
        lines.push(currentLine);
      }

      return lines.join('\n');
    }

    function applyPreviewState() {
      const overlay = getGlobalOverlay();
      const userOverlay = overlay ? overlay.querySelector('#engraving-overlay-user') : null;
      const gallery = document.querySelector('media-gallery');
      const selectedFont = getSelectedFont();
      const fontClass = 'preview-font-' + selectedFont;
      const rawValue = input.value;
      const trimmedValue = rawValue.trim();
      const hasText = trimmedValue.length > 0;

      input.className = 'engraving-option__input ' + fontClass;

      if (overlay && userOverlay) {
        userOverlay.className = 'engraved-text-effect engraving-text-user ' + fontClass;
        userOverlay.textContent = formatPreviewText(rawValue, selectedFont);
        userOverlay.style.fontSize = hasText ? getPreviewFontSize(trimmedValue.length, selectedFont).toFixed(2) + 'px' : '';
        /* Tighten letter-spacing as text grows longer */
        const letterSpacing = trimmedValue.length <= 4 ? '0.04em' : trimmedValue.length <= 10 ? '0.01em' : '-0.01em';
        userOverlay.style.letterSpacing = hasText ? letterSpacing : '';
        overlay.style.display = hasText ? 'flex' : 'none';
      }

      if (gallery) {
        const isMobile = window.innerWidth <= 1024;
        gallery.classList.toggle('is-engraving-active', toggle.checked && (hasText || isMobile));
      }
    }

    // Live character countdown
    function updateCountdown() {
      const remaining = MAX_CHARS - input.value.length;
      countdown.textContent = remaining + ' / ' + MAX_CHARS;
    }

    function setConfirmed(state) {
      isConfirmed = state;
      if (state) {
        confirmBtn.classList.add('is-confirmed');
        confirmBtn.textContent = 'CONFIRMED';
        block.setAttribute('data-confirmed', 'true');
        errorEl.style.display = 'none';
      } else {
        confirmBtn.classList.remove('is-confirmed');
        confirmBtn.textContent = 'CONFIRM';
        block.removeAttribute('data-confirmed');
      }
    }

    confirmBtn.addEventListener('click', () => {
      const text = input.value.trim();
      if (text) {
        setConfirmed(true);
      } else {
        errorEl.style.display = 'block';
        input.focus();
      }
    });

    toggle.addEventListener('change', async () => {
      block.classList.toggle('is-active', toggle.checked);
      const gallery = document.querySelector('media-gallery');

      if (toggle.checked) {
        // Show the input, focus it
        input.focus();
        errorEl.style.display = 'none';
        setConfirmed(false);

        // Gallery preview: trigger layout update only if text exists
        if (gallery && input.value.trim().length > 0) {
          gallery.classList.add('is-engraving-active');
          gallery.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (gallery.slideshow) {
            gallery.slideshow.select(0);
          }
        }
      } else {
        // Unchecked: remove engraving from cart if it exists
        const text = input.value.trim();
        if (text && window.EngravingCart) {
          await window.EngravingCart.removeEngraving(text);
          await window.EngravingCart.refreshCartDrawer();
        }

        // Clear UI state
        input.value = '';
        errorEl.style.display = 'none';
        setConfirmed(false);
        updateCountdown();

        // Hide gallery preview
        if (gallery) {
          gallery.classList.remove('is-engraving-active');
        }
      }
    });

    input.addEventListener('input', () => {
      updateCountdown();
      setConfirmed(false); // Reset confirmation on edit
      
      if (input.value.trim()) {
        errorEl.style.display = 'none';
      }

      applyPreviewState();
    });

    fontOptions.forEach(opt => {
      opt.addEventListener('change', () => {
        const selectedFont = opt.value.toLowerCase();

        // Toggle RTL for input field if Arabic is selected
        if (selectedFont === 'arabic') {
          input.setAttribute('dir', 'rtl');
          input.placeholder = 'أدخل النص الخاص بك'; // Arabic for "Enter your text"
        } else {
          input.setAttribute('dir', 'ltr');
          input.placeholder = 'Enter your text';
        }

        applyPreviewState();
      });
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        confirmBtn.click();
      }
    });

    updateCountdown();
    applyPreviewState();
    window.addEventListener('resize', applyPreviewState);
  })();
</script>
{%- endunless -%}

{% schema %}
{
  "name": "Custom Engraving",
  "settings": [],
  "presets": [
    {
      "name": "Custom Engraving"
    }
  ]
}
{% endschema %}
