{%- liquid
  assign section_id = 'section-' | append: section.id
-%}

<style>
  #{{ section_id }} {
    position: relative;
    z-index: 1;
    background-color: transparent;
    padding: 140px 0;
    color: #fff;
    min-height: 100vh;
    display: flex;
    align-items: center;
    font-family: var(--font-body--family), -apple-system, sans-serif;
    overflow: hidden;
  }

  .about-overlay__container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4vw;
    width: 100%;
    display: grid;
    /* Adjusted grid to give the left text box more width while keeping the right side prominent */
    grid-template-columns: 1.2fr 1.3fr;
    gap: 4vw;
    align-items: center;
  }

  .about-overlay__text-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(30px);
    transition: all 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    z-index: 10;
    
    /* Glassmorphism Panel */
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-top: 1px solid rgba(255, 255, 255, 0.35);
    border-left: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(25px) saturate(120%);
    -webkit-backdrop-filter: blur(25px) saturate(120%);
    border-radius: 24px;
    padding: 70px 60px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), inset 0 0 30px rgba(255, 255, 255, 0.03);
  }

  .about-overlay__text-col.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .about-overlay__heading {
    font-family: var(--font-heading--family), serif;
    font-size: clamp(3rem, 5.5vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    margin: 0 0 1.2rem;
    letter-spacing: -0.02em;
    color: #ffffff;
    text-shadow: 0 8px 25px rgba(0,0,0,0.5);
  }

  .about-overlay__subheading {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.35em;
    opacity: 0.9;
    margin-bottom: 2rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
  }

  .about-overlay__desc {
    font-size: clamp(1rem, 1.1vw, 1.15rem);
    line-height: 1.8;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.9);
    max-width: 650px;
    margin-bottom: 3rem;
  }

  .about-overlay__glass-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px 42px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 40px;
    color: #fff;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.75rem;
    font-weight: 500;
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    align-self: flex-start;
  }

  .about-overlay__glass-btn:hover {
    background: rgba(255, 255, 255, 1);
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.2);
  }

  .about-overlay__glass-btn svg {
    width: 14px;
    height: 14px;
    transition: transform 0.4s ease;
  }

  .about-overlay__glass-btn:hover svg {
    transform: translateX(3px);
  }

  .about-overlay__visual-col {
    position: relative;
    height: 85vh; /* Increased height for larger composition */
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1000px;
  }

  /* The Extra: Ambient Glowing Orb behind the glass */
  .about-overlay__ambient-orb {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 50vw;
    height: 50vw;
    background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 65%);
    border-radius: 50%;
    z-index: 1;
    filter: blur(50px);
    pointer-events: none;
    animation: orbFloat 12s ease-in-out infinite alternate;
    transform: translate(-50%, -50%);
  }

  @keyframes orbFloat {
    0% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.6; }
    100% { transform: translate(-45%, -55%) scale(1.1); opacity: 1; }
  }

  .about-overlay__glass-card {
    position: absolute;
    background: transparent;
    border: none;
    border-radius: 16px;
    padding: 0;
    overflow: hidden;
    transition: all 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
    opacity: 0;
  }

  .about-overlay__glass-card.is-visible {
    opacity: 1;
  }

  .about-overlay__glass-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    opacity: 0.75;
    mix-blend-mode: luminosity;
    transition: all 0.7s ease;
  }

  .about-overlay__glass-card:hover {
    transform: scale(1.06) translateY(-15px) translateZ(50px) !important;
    z-index: 20 !important;
  }

  .about-overlay__glass-card:hover img {
    opacity: 1;
    mix-blend-mode: normal;
  }

  /* 4-Image Editorial Composition */
  .about-overlay__card-1 {
    width: 52%;
    aspect-ratio: 3/4;
    top: 12%;
    left: 20%;
    z-index: 4;
    transform: rotate(-3deg) translateY(50px);
    transition-delay: 0.1s;
  }
  .about-overlay__card-1.is-visible { transform: rotate(-3deg) translateY(0); }

  .about-overlay__card-2 {
    width: 35%;
    aspect-ratio: 4/5;
    top: 5%;
    right: 15%;
    z-index: 3;
    transform: rotate(5deg) translateY(60px);
    transition-delay: 0.2s;
  }
  .about-overlay__card-2.is-visible { transform: rotate(5deg) translateY(0); }

  .about-overlay__card-3 {
    width: 42%;
    aspect-ratio: 4/3;
    bottom: 12%;
    left: 8%;
    z-index: 5;
    transform: rotate(-6deg) translateY(70px);
    transition-delay: 0.3s;
  }
  .about-overlay__card-3.is-visible { transform: rotate(-6deg) translateY(0); }

  .about-overlay__card-4 {
    width: 28%;
    aspect-ratio: 1/1;
    bottom: 8%;
    right: 22%;
    z-index: 6;
    transform: rotate(8deg) translateY(80px);
    transition-delay: 0.4s;
  }
  .about-overlay__card-4.is-visible { transform: rotate(8deg) translateY(0); }

  @media (max-width: 989px) {
    #{{ section_id }} {
      padding: 80px 0;
    }

    .about-overlay__container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 60px;
    }

    .about-overlay__text-col {
      padding: 40px 25px;
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
    }

    .about-overlay__desc {
      margin: 0 auto 2.5rem;
      max-width: 100%;
    }

    .about-overlay__glass-btn {
      align-self: center;
    }

    .about-overlay__visual-col {
      height: 60vh; /* slightly increased to accommodate larger cards */
      margin-top: 20px;
    }

    .about-overlay__glass-card {
      padding: 0;
    }

    /* Tightly packed clustered positioning for mobile with larger images */
    .about-overlay__card-1 { width: 62%; left: 8%; top: 5%; }
    .about-overlay__card-2 { width: 50%; right: 5%; top: 18%; }
    .about-overlay__card-3 { width: 56%; left: 5%; bottom: 12%; }
    .about-overlay__card-4 { width: 40%; right: 8%; bottom: 6%; }
  }
</style>

<section id="{{ section_id }}">
  <div id="about-us" style="position: absolute; top: -100px; left: 0; width: 1px; height: 1px; visibility: hidden; pointer-events: none;"></div>
  <div class="about-overlay__container">
    
    <div class="about-overlay__text-col" data-about-reveal>
      {%- if section.settings.sub_heading != blank -%}
        <div class="about-overlay__subheading">{{ section.settings.sub_heading | escape }}</div>
      {%- endif -%}
      
      {%- if section.settings.main_heading != blank -%}
        <h2 class="about-overlay__heading">{{ section.settings.main_heading | escape }}</h2>
      {%- endif -%}

      <div class="about-overlay__desc">
        {{ section.settings.block1_desc }}
      </div>

      {%- if section.settings.insta_btn_label != blank -%}
        <a href="{{ section.settings.insta_btn_link | default: 'https://www.instagram.com/tryoverlay' }}" class="about-overlay__glass-btn" target="_blank" rel="noopener">
          {{ section.settings.insta_btn_label }}
        </a>
      {%- endif -%}
    </div>

    <div class="about-overlay__visual-col">
      <!-- The Extra: Ambient Glowing Orb -->
      <div class="about-overlay__ambient-orb"></div>

      <!-- Card 2: Top Right -->
      <div class="about-overlay__glass-card about-overlay__card-2" data-about-reveal>
        {%- if section.settings.carousel_img_2 != blank -%}
          <img src="{{ section.settings.carousel_img_2 | image_url: width: 600 }}" alt="About Image 2" loading="lazy" width="600" height="800">
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0774/2894/9215/files/IMG_5231.png?v=1780514461" alt="About Image 2" loading="lazy" width="600" height="800">
        {%- endif -%}
      </div>

      <!-- Card 1: Main Center/Left -->
      <div class="about-overlay__glass-card about-overlay__card-1" data-about-reveal>
        {%- if section.settings.carousel_img_1 != blank -%}
          <img src="{{ section.settings.carousel_img_1 | image_url: width: 800 }}" alt="About Image 1" loading="lazy" width="800" height="1000">
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0774/2894/9215/files/IMG_5230.png?v=1780514459" alt="About Image 1" loading="lazy" width="800" height="1000">
        {%- endif -%}
      </div>

      <!-- Card 3: Bottom Left -->
      <div class="about-overlay__glass-card about-overlay__card-3" data-about-reveal>
        {%- if section.settings.carousel_img_3 != blank -%}
          <img src="{{ section.settings.carousel_img_3 | image_url: width: 800 }}" alt="About Image 3" loading="lazy" width="800" height="600">
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0774/2894/9215/files/IMG_5232.png?v=1780514463" alt="About Image 3" loading="lazy" width="800" height="600">
        {%- endif -%}
      </div>

      <!-- Card 4: Bottom Right -->
      <div class="about-overlay__glass-card about-overlay__card-4" data-about-reveal>
        {%- if section.settings.carousel_img_4 != blank -%}
          <img src="{{ section.settings.carousel_img_4 | image_url: width: 500 }}" alt="About Image 4" loading="lazy" width="500" height="500">
        {%- else -%}
          <img src="https://cdn.shopify.com/s/files/1/0774/2894/9215/files/IMG_5234.png?v=1780514459" alt="About Image 4" loading="lazy" width="500" height="500">
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
  (function() {
    const observerOptions = {
      root: null,
      rootMargin: '0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const revealElements = document.querySelectorAll('#{{ section_id }} [data-about-reveal]');
    revealElements.forEach(el => observer.observe(el));
  })();
</script>

{% schema %}
{
  "name": "About Us Cinematic",
  "settings": [
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "About Us"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "All over spray house"
    },
    {
      "type": "inline_richtext",
      "id": "block1_desc",
      "label": "Description",
      "default": "OVERLAY is an all over spray house built around layering and everyday wear. Designed for skin, clothes, hair, and space, each scent is made to be worn freely, mixed naturally, and used without limits. We don’t believe in having one signature scent or wearing fragrance the same way every day. Some stay soft, others leave a trace, but all of them are made to live with you."
    },
    {
      "type": "text",
      "id": "insta_btn_label",
      "label": "Button Label",
      "default": "Follow our journey"
    },
    {
      "type": "url",
      "id": "insta_btn_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Imagery Settings"
    },
    {
      "type": "image_picker",
      "id": "carousel_img_1",
      "label": "Primary Image (Center)"
    },
    {
      "type": "image_picker",
      "id": "carousel_img_2",
      "label": "Secondary Image (Top Right)"
    },
    {
      "type": "image_picker",
      "id": "carousel_img_3",
      "label": "Tertiary Image (Bottom Left)"
    },
    {
      "type": "image_picker",
      "id": "carousel_img_4",
      "label": "Quaternary Image (Bottom Right)"
    }
  ],
  "presets": [
    {
      "name": "About Us Cinematic"
    }
  ]
}
{% endschema %}
