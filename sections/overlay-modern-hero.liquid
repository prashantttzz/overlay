{%- liquid
  assign section_id = 'section-' | append: section.id
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500;1,600&display=swap" rel="stylesheet">

{%- style -%}
    /* Removed FreeScript font face */

  #{{ section_id }} {
    --neon: #ffffff;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: transparent;
    color: #fff;
    position: relative;
    z-index: 1;
    height: 100vh;
  }

  /* ── Video Background Layer ── */
  .overlay-hero__video-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -10;
    pointer-events: none;
  }

  .overlay-hero__video-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(0,0,0,0.6) 0%,
      rgba(0,0,0,0.2) 50%,
      rgba(0,0,0,0.75) 100%
    );
    z-index: 2;
  }

  .overlay-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-video-zoom 26s ease-in-out infinite alternate;
  }

  @keyframes hero-video-zoom {
    from { transform: scale(1.02); }
    to   { transform: scale(1.12); }
  }

  /* ── Layout Container ── */
  .overlay-hero {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100vh;
    padding-inline: clamp(1.5rem, 5vw, 5rem);
    position: relative;
    z-index: 2;
    transform: translateZ(0); /* Foreground layer anchor */
  }

  /* ── Main Content Container ── */
  .overlay-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding-bottom: clamp(4rem, 8vh, 8rem);
    will-change: transform, opacity;
  }

  /* ── Typography ── */
  .overlay-hero__heading {
    font-family: var(--font-heading--family), serif !important;
    font-size: clamp(3rem, 6.5vw, 7rem);
    font-weight: 500;
    font-style: normal;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: none;
    color: #fff;
    margin: 0 0 1.5rem;
    min-height: 1.4em; 
    text-shadow: 0 4px 24px rgba(0,0,0,0.3);
  }

  /* Typewriter cursor */
  .overlay-hero__cursor {
    display: inline-block;
    width: 3px;
    height: 0.8em;
    background: var(--neon);
    margin-left: 6px;
    vertical-align: middle;
    border-radius: 1px;
    animation: blink-cursor 0.75s step-end infinite;
  }

  @keyframes blink-cursor {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  .overlay-hero__cursor--done {
    animation: cursor-fade-out 0.8s ease forwards;
  }

  @keyframes cursor-fade-out {
    to { opacity: 0; width: 0; margin: 0; }
  }

  .overlay-hero__description {
    font-size: clamp(0.85rem, 1.2vw, 1.05rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
    max-width: 600px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 300;
    margin: 0 0 2.5rem;
    text-shadow: 0 2px 10px rgba(0,0,0,0.4);
  }

  /* ── Glassmorphism CTA Button ── */
  .overlay-hero__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1.15rem 3.2rem;
    font-size: clamp(0.8rem, 1vw, 0.95rem);
    font-weight: 500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
    transition: background 0.4s cubic-bezier(0.25, 1, 0.5, 1), 
                border-color 0.4s cubic-bezier(0.25, 1, 0.5, 1), 
                transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
                box-shadow 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  /* Ambient Glass Highlight Shimmer */
  .overlay-hero__cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.15),
      transparent
    );
    transition: none;
  }

  /* Hover States */
  .overlay-hero__cta:hover {
    background: rgba(255, 255, 255, 0.13);
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 12px 40px 0 rgba(0, 0, 0, 0.45),
                0 0 15px 1px rgba(255, 255, 255, 0.05);
  }

  .overlay-hero__cta:hover::before {
    left: 100%;
    transition: left 0.85s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .overlay-hero__cta:active {
    transform: translateY(1px);
  }

  /* ── Entry Animations ── */
  .hero-animate {
    opacity: 0;
    animation-fill-mode: both;
    animation-duration: 1.2s;
    animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-animate--fade-up { animation-name: heroFadeUp; }
  .hero-animate--d4 { animation-delay: 0.6s; }
  .hero-animate--d5 { animation-delay: 0.85s; }

  @keyframes heroFadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Responsive Scaling ── */
  @media (max-width: 768px) {
    #{{ section_id }} {
      height: 100svh;
    }

    .overlay-hero__video-wrapper {
      position: fixed;
      top: 0;
      height: 100svh;
      transform: none !important;
    }

    .overlay-hero {
      padding-inline: 1.5rem;
      justify-content: center;
      height: 100svh;
    }

    .overlay-hero__content {
      padding-bottom: 0;
      align-items: center;
      text-align: center;
    }

    .overlay-hero__heading {
      font-size: clamp(2.5rem, 11vw, 4.5rem);
      line-height: 1.1;
      margin-bottom: 1.2rem;
      width: 100%;
    }

    .overlay-hero__description {
      font-size: 0.8rem;
      max-width: 100%;
      letter-spacing: 0.14em;
      margin-inline: auto;
      margin-bottom: 2.2rem;
    }

    .overlay-hero__cta {
      width: 100%;
      max-width: 290px;
      padding: 1.1rem 2rem;
    }
  }
{%- endstyle -%}

<section id="{{ section_id }}" data-home-hero>

  <!-- Parallax Video Background Layer -->
  <div class="overlay-hero__video-wrapper">
    <video
      class="overlay-hero__video"
      autoplay
      loop
      muted
      playsinline
      webkit-playsinline
      {%- if section.settings.image != blank -%}
        poster="{{ section.settings.image | image_url: width: 2000 }}"
      {%- endif -%}
    >
      <source src="{{ section.settings.video_url | default: 'https://cdn.shopify.com/videos/c/o/v/dcd2211b302f47169295b9baf0652208.mp4' }}" type="video/mp4">
    </video>
  </div>

  <div class="overlay-hero">
    <!-- Foreground Content Layer -->
    <div class="overlay-hero__content">

      {%- if section.settings.heading != blank -%}
        <h1 class="overlay-hero__heading hero-animate hero-animate--fade-up">
          {{ section.settings.heading | newline_to_br }}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="overlay-hero__description hero-animate hero-animate--fade-up hero-animate--d4">
          {{ section.settings.description }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="overlay-hero__cta hero-animate hero-animate--fade-up hero-animate--d5">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

    </div>
  </div>

</section>

<script>
(function () {
  var heroSection = document.querySelector('[data-home-hero]');
  if (!heroSection) return;

  var heroContent = heroSection.querySelector('.overlay-hero__content');
  var heroVideo = heroSection.querySelector('.overlay-hero__video');

  // ── Autoplay Video Force (iOS / Safari) ─────────────────────
  if (heroVideo) {
    heroVideo.muted = true;
    heroVideo.playsInline = true;
    var playPromise = heroVideo.play();
    if (playPromise !== undefined) {
      playPromise.catch(function(error) {
        var playOnInteraction = function() {
          heroVideo.play();
          document.removeEventListener('touchstart', playOnInteraction);
          document.removeEventListener('click', playOnInteraction);
          document.removeEventListener('scroll', playOnInteraction);
        };
        document.addEventListener('touchstart', playOnInteraction, { passive: true });
        document.addEventListener('click', playOnInteraction, { passive: true });
        document.addEventListener('scroll', playOnInteraction, { passive: true });
      });
    }
  }

  // ── Parallax & Ambient Fade ─────────────────────────────────
  var videoWrapper = heroSection.querySelector('.overlay-hero__video-wrapper');
  if (heroContent && window.matchMedia('(min-width: 769px)').matches) {
    var isTicking = false;
    
    function onScroll() {
      if (!isTicking) {
        window.requestAnimationFrame(updateEffects);
        isTicking = true;
      }
    }

    function updateEffects() {
      var scrollY = window.scrollY;
      var sectionTop = heroSection.offsetTop;
      var maxScroll = heroSection.offsetHeight;
      
      // Relative scroll within the section
      var relativeScrollY = scrollY - sectionTop;
      if (relativeScrollY < 0) relativeScrollY = 0;
      
      // Background is now position: fixed, so no JS transform is needed
      // to keep it completely stationary in the viewport as requested.

      // Content Parallax & Alpha Fade
      if (heroContent) {
        // Scroll content slower than the page so the next section catches up to it
        if (scrollY < sectionTop + maxScroll) {
          var yPosContent = relativeScrollY * 0.4;
          heroContent.style.transform = 'translate3d(0, ' + yPosContent + 'px, 0)';
        }

        var fadeStart = maxScroll * 0.25;
        if (relativeScrollY > fadeStart) {
          var opacity = Math.max(0, 1 - (relativeScrollY - fadeStart) / (maxScroll * 0.5 - fadeStart));
          heroContent.style.opacity = opacity.toFixed(3);
        } else {
          heroContent.style.opacity = '1';
        }
      }
      
      isTicking = false;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    updateEffects();
  }

  // ── Typewriter Engine (Removed) ──────────────────────────────────────────
})();
</script>

{% schema %}
{
  "name": "Overlay Modern Hero",
  "settings": [
    {
      "type": "text",
      "id": "video_url",
      "label": "Video Background URL",
      "default": "https://cdn.shopify.com/videos/c/o/v/dcd2211b302f47169295b9baf0652208.mp4"
    },
    {
      "type": "text",
      "id": "pre_heading",
      "label": "Pre-Heading Label",
      "default": "The Art of Layering"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "ALL OVER\nSPRAY HOUSE"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "MADE TO BE MIXED."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Background Image"
    },
    {
      "type": "header",
      "content": "Styles"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Note",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Overlay Modern Hero"
    }
  ]
}
{% endschema %}