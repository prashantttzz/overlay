{%- comment -%}
  Hero Video Background Section
  Renders the global fixed video and the transparent hero content.
{%- endcomment -%}

{{ 'video-parallax.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<!-- Global Fixed Video Container -->
<div class="fixed-video-background">
  {%- if section.settings.video != blank -%}
    {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, class: 'video-cover' }}
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'video-cover placeholder-svg' }}
  {%- endif -%}
  
  {%- if section.settings.video_overlay_opacity > 0 -%}
    <div class="fixed-video-overlay" style="opacity: {{ section.settings.video_overlay_opacity | divided_by: 100.0 }}; background-color: {{ section.settings.video_overlay_color }};"></div>
  {%- endif -%}
</div>

<!-- Hero Content (Transparent Window) -->
<div class="parallax-transparent-section section-{{ section.id }}-padding">
  <div class="page-width text-center mx-auto max-w-4xl px-4">
    {%- if section.settings.heading != blank -%}
      <h1 class="text-4xl md:text-6xl font-bold mb-4" style="color: {{ section.settings.text_color }}">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    
    {%- if section.settings.text != blank -%}
      <div class="text-lg md:text-xl mb-8" style="color: {{ section.settings.text_color }}">{{ section.settings.text }}</div>
    {%- endif -%}
    
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="inline-block bg-white text-black px-8 py-3 rounded-md font-semibold hover:bg-gray-100 transition-colors">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero Video Parallax",
  "class": "transparent-parallax-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Background Video (Global)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background Video",
      "info": "This video stays fixed behind the page."
    },
    {
      "type": "range",
      "id": "video_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Video Overlay Opacity",
      "default": 30
    },
    {
      "type": "color",
      "id": "video_overlay_color",
      "label": "Video Overlay Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Continuous Video Parallax"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Scroll down to see the background mechanics.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Hero Video Parallax"
    }
  ]
}
{% endschema %}
